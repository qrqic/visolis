# Postavke za hosting udrugavissolis.hr (Apache u Plesku).
#  - sve adrese vode na https://udrugavissolis.hr (bez www, uvijek https)
#  - adrese bez .html: /hipoterapija umjesto /hipoterapija.html, / umjesto /index.html
#  - preglednik dulje pamti slike, fontove i stilove (brže učitavanje)

Options -MultiViews -Indexes
# Bez automatskog dodavanja kose crte, da /dokumenti uvijek vodi na stranicu, a ne na mapu.
DirectorySlash Off
DirectoryIndex index.html
AddDefaultCharset utf-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # http -> https i www -> bez www, u jednom koraku
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://udrugavissolis.hr%{REQUEST_URI} [R=301,L,NE]

  # Stare adrese s .html preusmjeravaju se na nove (samo kad ih posjetitelj izravno traži)
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+([a-z0-9-]+)\.html[\s?] [NC]
  RewriteCond %{REQUEST_URI} !^/google[0-9a-f]+\.html$ [NC]
  RewriteRule ^([a-z0-9-]+)\.html$ /$1 [R=301,L,NC]

  # /hipoterapija -> hipoterapija.html (adresa u pregledniku ostaje bez .html)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([a-z0-9-]+)/?$ $1.html [L,NC]
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 1 hour"
  ExpiresByType text/javascript "access plus 1 hour"
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml text/plain application/xml
</IfModule>
